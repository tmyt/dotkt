{
  "$schema": "http://json.schemastore.org/template",
  "author": "DotKt",
  "classifications": [ "Console", "Kotlin", "DotKt" ],
  "identity": "DotKt.Templates.Cli",
  "name": "DotKt CLI Application",
  "description": "A minimal command-line application written in Kotlin, built to .NET via the DotKt SDK.",
  "shortName": "dotkt-cli",
  "tags": { "language": "Kotlin", "type": "project" },
  "sourceName": "DotKtApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [ { "choice": "net10.0", "description": ".NET 10" } ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}
