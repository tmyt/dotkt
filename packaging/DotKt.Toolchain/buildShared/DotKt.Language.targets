<Project>
  <!-- Reuse the SDK's project/reference/deployment integration, not its C# compilation. This file is also packed
       inside DotKt.Sdk so it is available on the first restore, before the Toolchain package has been resolved. -->
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets" />
  <PropertyGroup>
    <Language>Kotlin</Language>
    <!-- No source PDB is emitted yet. Set output facts during evaluation so no-build publish/project-reference
         paths do not attempt to copy a nonexistent file; preserve the user's DebugSymbols/DebugType settings. -->
    <_DebugSymbolsProduced>false</_DebugSymbolsProduced>
  </PropertyGroup>
  <ItemGroup>
    <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
    <_DebugSymbolsOutputPath Remove="@(_DebugSymbolsOutputPath)" />
  </ItemGroup>
  <Target Name="CoreCompile" DependsOnTargets="$(CoreCompileDependsOn)" />
</Project>
