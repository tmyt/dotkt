<Project>
  <!-- Reuse the SDK's project/reference/deployment integration, not its C# compilation. This file is also packed
       inside DotKt.Sdk so it is available on the first restore, before the Toolchain package has been resolved. -->
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets" />
  <PropertyGroup>
    <Language>Kotlin</Language>
    <!-- No Kotlin XML documentation emitter exists either; do not advertise the placeholder C# compiler's XML. -->
    <_DocumentationFileProduced>false</_DocumentationFileProduced>
  </PropertyGroup>
  <ItemGroup>
    <DocFileItem Remove="@(DocFileItem)" />
    <FinalDocFile Remove="@(FinalDocFile)" />
    <DocumentationProjectOutputGroupOutput Remove="@(DocumentationProjectOutputGroupOutput)" />
  </ItemGroup>
  <Target Name="CoreCompile" DependsOnTargets="$(CoreCompileDependsOn)" />
</Project>
