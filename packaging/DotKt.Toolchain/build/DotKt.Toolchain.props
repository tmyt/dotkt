<Project>
  <!-- The compiler toolchain binaries, at package-internal paths (no repo dependency). The compiler is JVM-based,
       so a JRE must be on PATH. -->
  <PropertyGroup>
    <DotKtToolchainDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/'))</DotKtToolchainDir>
    <DotKtCompiler Condition="'$(DotKtCompiler)' == ''">$(DotKtToolchainDir)kotc/bin/kotc</DotKtCompiler>
    <!-- kotc -classpath: the CLR FRONTEND stdlib jar (built FROM our CLR stdlib sources), REPLACING the JVM
         kotlin-stdlib.jar whose java.util.* typealiases leaked into the frontend. kotlin.* resolves from THIS jar. -->
    <DotKtStdlib Condition="'$(DotKtStdlib)' == ''">$(DotKtToolchainDir)kotlin-stdlib-clr-frontend.jar</DotKtStdlib>
    <DotKtBir2Cir Condition="'$(DotKtBir2Cir)' == ''">$(DotKtToolchainDir)bir2cir/bir2cir.dll</DotKtBir2Cir>
    <DotKtIlEmit Condition="'$(DotKtIlEmit)' == ''">$(DotKtToolchainDir)ilemit/ilemit.dll</DotKtIlEmit>
    <DotKtFacadeGen Condition="'$(DotKtFacadeGen)' == ''">$(DotKtToolchainDir)facadegen/facadegen.dll</DotKtFacadeGen>
    <!-- Repoints the emitted dll's BCL refs off System.Private.CoreLib so a C# project can <ProjectReference> it. -->
    <DotKtRetargetTool Condition="'$(DotKtRetargetTool)' == ''">$(DotKtToolchainDir)retarget/retarget.dll</DotKtRetargetTool>
  </PropertyGroup>
</Project>
