<!-- DotKt build pipeline (kt -> BIR -> CIL) — the SINGLE source of truth, shipped WITH the toolchain that it
     drives. NuGet auto-imports this (build/<PackageId>.targets) for any project referencing DotKt.Toolchain,
     so the DotKt.Sdk just references the toolchain and the pipeline comes along. The in-repo dev entry
     (eng/KotlinClr.targets) imports it explicitly. Tool paths come from DotKt.Toolchain.props ($(DotKt*)). -->
<Project>
  <PropertyGroup>
    <DotKtOut>$(BaseIntermediateOutputPath)dotkt-bir</DotKtOut>
    <DotKtCirOut>$(BaseIntermediateOutputPath)dotkt-cir</DotKtCirOut>
    <!-- Incremental stamps for the back-half (#134). The BIR/CIR dirs are glob OUTPUTS (a variable file set), so
         each back-half target keys its Inputs/Outputs off a stable .stamp instead of the dir glob: KotlinCompile's
         $(DotKtOut)/.stamp bumps ONLY on a real recompile, so the whole chain (bir2cir -> ilemit -> retarget)
         cascades exactly when the frontend produced new BIR and no-ops otherwise. RetargetStamp lives outside the
         wiped CIR/BIR dirs because retarget rewrites the emitted dll IN PLACE (output == input), so it needs its
         own out-of-band completion marker. -->
    <DotKtRetargetStamp>$(BaseIntermediateOutputPath)dotkt-retarget.stamp</DotKtRetargetStamp>
    <DotKtUseDll2Klib Condition="'$(DotKtUseDll2Klib)' == ''">false</DotKtUseDll2Klib>
    <DotKtReferenceKlibDir>$(BaseIntermediateOutputPath)dotkt-reference-klibs</DotKtReferenceKlibDir>
    <DotKtTypeMeta>$(BaseIntermediateOutputPath)dotkt-clrtypes.meta</DotKtTypeMeta>
    <!-- The .NET import list extracted from the .kt sources by the kotc scan-imports pass (PSI parser, not regex). -->
    <DotKtImportList>$(BaseIntermediateOutputPath)dotkt-clrimports.txt</DotKtImportList>
    <!-- Non-file compile options (raw kotc flags + MPP config) hashed into a manifest file so a change to an OPTION
         (not a source) still flips a timestamp and retriggers the incremental KotlinCompile (#50). -->
    <DotKtOptionsManifest>$(BaseIntermediateOutputPath)dotkt-compile-options.txt</DotKtOptionsManifest>
    <!-- The EXPLICIT, ordered @(DotKtImport) list materialized into a manifest file so adding/removing/reordering a
         <DotKtImport> flips a timestamp and retriggers DotKtInjectTypes below (#161). @(DotKtImport) is a non-file
         item and cannot itself be a target Input, so without this a removed import left STALE injection metadata
         ($(DotKtTypeMeta)) — a build that referenced the dropped .NET type kept succeeding until an unrelated .kt
         edit finally forced a recompile. -->
    <DotKtImportManifest>$(BaseIntermediateOutputPath)dotkt-clrimports-explicit.txt</DotKtImportManifest>
    <!-- ilemit emits real CIL (Reflection.Emit) and must load each referenced type's RUNTIME (implementation)
         assembly — it takes its refs from @(ReferenceCopyLocalPaths) (the runtime set), NOT @(ReferencePath) (which
         resolves to a package's ref/ reference assembly — method-body-less; deriving a class from one fails with
         "does not have an implementation"). For OutputType=Library a package's runtime dll is NOT copy-local by
         default (CopyLocalLockFileAssemblies defaults false for a non-runtime output), so a Library consuming any
         DotKt/.NET package would starve ilemit of it (#132). Force the transitive package runtime assets into the
         copy-local set so ilemit sees them for a Library exactly as it already does for an Exe. -->
    <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Resolve references ONCE.  MSBuild/RAR owns selection and conflict resolution; the DotKt tools consume these
       exact files and never reconstruct the graph by scanning neighbouring directories.  The runtime set is
       narrowed only to DLL-shaped assets to avoid passing pdb/json files; managed-vs-native is decided from the PE
       CLI header by the shared tool-side reference catalog. -->
  <Target Name="DotKtResolveReferenceSets" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_DotKtCompileReference Include="@(ReferencePath)" />
      <_DotKtRuntimeReference Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <_DotKtKlibReference Include="@(ReferencePathWithRefAssemblies)"
                           Condition="'$(DotKtUseDll2Klib)' == 'true' and '%(Extension)' == '.dll' and '%(Filename)' != 'DotKt.Private.Stdlib' and '%(Filename)' != 'DotKt.Stdlib'">
        <KlibPath>$(DotKtReferenceKlibDir)/%(Filename).klib</KlibPath>
      </_DotKtKlibReference>
      <_DotKtKlibReference Include="@(_DotKtCompileReference)"
                           Condition="'$(DotKtUseDll2Klib)' == 'true' and '@(ReferencePathWithRefAssemblies)' == '' and '%(Extension)' == '.dll' and '%(Filename)' != 'DotKt.Private.Stdlib' and '%(Filename)' != 'DotKt.Stdlib'">
        <KlibPath>$(DotKtReferenceKlibDir)/%(Filename).klib</KlibPath>
      </_DotKtKlibReference>
      <_DotKtFrontendMetadataInput Include="@(_DotKtKlibReference->'%(KlibPath)')"
                                   Condition="'$(DotKtUseDll2Klib)' == 'true'" />
      <_DotKtFrontendMetadataInput Include="$(DotKtTypeMeta)"
                                   Condition="'$(DotKtUseDll2Klib)' != 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <_DotKtCompileReferences>@(_DotKtCompileReference->'%(FullPath)', ';')</_DotKtCompileReferences>
      <_DotKtRuntimeReferences>@(_DotKtRuntimeReference->'%(FullPath)', ';')</_DotKtRuntimeReferences>
    </PropertyGroup>
  </Target>

  <!-- One target batch per resolved reference: one stale DLL starts one process and
       produces one project-local packed KLIB. No shared cache participates. -->
  <Target Name="DotKtGenerateReferenceKlibs"
          DependsOnTargets="DotKtResolveReferenceSets"
          Condition="'$(DotKtUseDll2Klib)' == 'true'"
          Inputs="%(_DotKtKlibReference.FullPath);$(DotKtDll2Klib)"
          Outputs="%(_DotKtKlibReference.KlibPath)">
    <MakeDir Directories="$(DotKtReferenceKlibDir)" />
    <Message Importance="high" Text="DotKt: %(_DotKtKlibReference.Filename).dll -> %(_DotKtKlibReference.KlibPath)" />
    <Exec Command="dotnet &quot;$(DotKtDll2Klib)&quot; &quot;%(_DotKtKlibReference.FullPath)&quot; &quot;%(_DotKtKlibReference.KlibPath)&quot;" />
  </Target>

  <!-- MPP (#119): opt-in multiplatform (common `expect` + CLR `actual`) for an ordinary user project.
       When <DotKtMultiplatform>true</DotKtMultiplatform>, sources under a `common/` directory are the
       common (expect-carrying, platform-agnostic) fragment — matching both the greeter experiment's
       layout and Kotlin's commonMain convention — and everything else is the CLR platform (actual)
       fragment. A project may instead list common sources explicitly via <DotKtCommon Include="..."/>;
       that takes precedence over the convention glob. When DotKtCommon ends up empty the compile is a
       plain single-fragment build — byte-identical to a non-MPP project (the flags below are never added).
       PACKAGING FOLLOW-UP: the design (task #119) calls for a distinct `DotKt.Sdk.Mpp` SDK that imports
       the base SDK and layers this on (composition, like Microsoft.NET.Sdk.Web). This property-gated slice
       lives in the shared pipeline so it is inert for every existing project; standing up the separate SDK
       package is the productization follow-up. -->
  <ItemGroup Condition="'$(DotKtMultiplatform)' == 'true' and '@(DotKtCommon)' == ''">
    <DotKtCommon Include="common/**/*.kt" />
  </ItemGroup>

  <!-- KLIB as an incremental input (#50): the frontend klib is an unpacked DIRECTORY (both the in-repo build and the
       shipped tools/kotlin-stdlib-clr-frontend.klib), and MSBuild's Inputs timestamp check treats a directory path as
       a MISSING file — which would force KotlinCompile to rebuild every single build. So key the input off a stable
       FILE inside the klib (default/manifest, rewritten on every klib build) instead of the directory path; fall back
       to the path itself should a future klib ship packed as one .klib file. Referenced as @(_DotKtStdlibInput) below. -->
  <ItemGroup>
    <_DotKtStdlibInput Include="$(DotKtStdlib)/default/manifest" Condition="Exists('$(DotKtStdlib)/default/manifest')" />
    <_DotKtStdlibInput Include="$(DotKtStdlib)" Condition="!Exists('$(DotKtStdlib)/default/manifest') and Exists('$(DotKtStdlib)')" />
  </ItemGroup>

  <!-- Materialize the ordered EXPLICIT @(DotKtImport) set into $(DotKtImportManifest) BEFORE DotKtInjectTypes'
       incremental check (it is a DependsOnTargets of it), so the manifest is a valid Input there (#161).
       WriteOnlyWhenDifferent keeps the timestamp stable when the imports are unchanged (no spurious re-injection)
       and flips it the instant one is added/removed/reordered — which is exactly what makes a removed <DotKtImport>
       re-run injection instead of leaving stale metadata. An empty @(DotKtImport) writes an empty manifest (still a
       real file), so going non-empty -> empty also flips the timestamp. -->
  <Target Name="DotKtComputeImportManifest" Condition="'@(KotlinCompile)' != ''">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(DotKtImportManifest)'))" />
    <WriteLinesToFile File="$(DotKtImportManifest)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="@(DotKtImport->'%(Identity)')" />
  </Target>

  <!-- C-2: import-driven, façade-FREE .NET type injection. The .kt sources' imports are extracted with the real
       Kotlin parser (PSI) and those .NET types injected straight into FIR (no .kt produced). @(ReferencePath)
       (BCL + PackageReference/Reference) makes any referenced assembly's types injectable. -->
  <!-- Incremental: the injection metadata is a pure function of the .kt sources (their imports), the EXPLICIT
       @(DotKtImport) set (via $(DotKtImportManifest), materialized by DotKtComputeImportManifest below — #161), the
       resolved compile references, and the compiler version (binary mtime). Guarding on those keeps $(DotKtTypeMeta)
       BYTE- and TIMESTAMP-stable across a no-op rebuild, so it can serve as a precise KotlinCompile input below (#50)
       instead of bumping every build and forcing an unconditional recompile. -->
  <Target Name="DotKtInjectTypes" BeforeTargets="KotlinCompile"
          DependsOnTargets="DotKtResolveReferenceSets;DotKtComputeImportManifest"
          Condition="'@(KotlinCompile)' != '' and '$(DotKtUseDll2Klib)' != 'true'"
          Inputs="@(KotlinCompile);@(_DotKtCompileReference);$(DotKtCompiler);$(DotKtImportManifest)" Outputs="$(DotKtTypeMeta)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(DotKtTypeMeta)'))" />
    <!-- 1. Extract .NET imports via the compiler's PSI pass (robust where the old regex was not — item 5). -->
    <Message Importance="high" Text="DotKt: scanning .NET imports from @(KotlinCompile->Count()) .kt file(s) (PSI parser)" />
    <Exec Command="&quot;$(DotKtCompiler)&quot; --scan-imports --output &quot;$(DotKtImportList)&quot; @(KotlinCompile->'&quot;%(FullPath)&quot;', ' ')" />
    <!-- 2. Reflect over the imported (+ explicit <DotKtImport>) types -> FIR-injection metadata for the .NET space ONLY.
         The stdlib (kotlin.*) is deliberately NOT scanned here: kotc resolves it from the KLIB (-classpath), which
         carries the full Kotlin semantics — Companion objects (the stdlib is implemented premised on them), inline,
         operator, infix — that facadegen cannot fully restore. Feeding stdlib.dll to facadegen produced degraded and
         DUPLICATE kotlin.* symbols (e.g. a non-reified arrayOf colliding with the klib's reified one -> ambiguity). -->
    <Message Importance="high" Text="DotKt: resolving .NET types (import list + @(DotKtImport))" />
    <Exec Command="dotnet &quot;$(DotKtFacadeGen)&quot; &quot;$(DotKtTypeMeta)&quot; --compile-refs &quot;$(_DotKtCompileReferences)&quot; @(DotKtImport->'%(Identity)', ' ') --import-list &quot;$(DotKtImportList)&quot;" />
  </Target>

  <!-- Materialize the non-file compile options into $(DotKtOptionsManifest) BEFORE KotlinCompile's incremental check so
       the manifest is a valid Input there (#50). The MPP flags are computed here (not in the compile body) so both the
       manifest and the compile Exec see the same $(DotKtMppFlags). WriteOnlyWhenDifferent keeps the file's timestamp
       stable when the options are unchanged (no spurious recompile) and flips it the instant any option changes. -->
  <Target Name="DotKtComputeCompileOptions" Condition="'@(KotlinCompile)' != ''">
    <!-- MPP (#119): when common sources are present, mark them with -Xcommon-sources and enable the common→platform
         module split (-Xmulti-platform) + cross-module expect/actual (-Xexpect-actual-classes) — the exact
         invocation the MPP NUnit producer exercises. All sources still pass POSITIONALLY (in @(KotlinCompile));
         -Xcommon-sources only tags which of them are common. Empty DotKtCommon => empty flags => unchanged compile. -->
    <PropertyGroup Condition="'@(DotKtCommon)' != ''">
      <DotKtMppFlags>-Xmulti-platform -Xexpect-actual-classes -Xcommon-sources=&quot;@(DotKtCommon->'%(FullPath)', ',')&quot;</DotKtMppFlags>
    </PropertyGroup>
    <WriteLinesToFile File="$(DotKtOptionsManifest)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="DotKtUseDll2Klib=$(DotKtUseDll2Klib);$(DotKtKotcOptions);$(DotKtMppFlags);@(DotKtCommon->'%(FullPath)')" />
  </Target>

  <!-- Compile every .kt to BIR. CLR_TYPES_METADATA tells the FIR injector which façade-free .NET types to synthesize.
       Incremental inputs (#50): besides the .kt sources, a recompile must also retrigger when the COMPILER changes
       ($(DotKtCompiler) mtime = version proxy), the frontend KLIB changes ($(DotKtStdlib)), the injected .NET type
       metadata changes ($(DotKtTypeMeta)), any resolved reference DLL changes (@(_DotKtCompileReference)/
       @(_DotKtRuntimeReference)), or a non-file compile OPTION changes ($(DotKtOptionsManifest)). DotKtResolveReferenceSets
       is a direct dependency so the @(_DotKt*Reference) items exist when these Inputs are evaluated. -->
  <Target Name="KotlinCompile" BeforeTargets="CoreCompile"
          DependsOnTargets="DotKtInjectTypes;DotKtGenerateReferenceKlibs;DotKtResolveReferenceSets;DotKtComputeCompileOptions"
          Inputs="@(KotlinCompile);$(DotKtCompiler);@(_DotKtStdlibInput);@(_DotKtFrontendMetadataInput);$(DotKtOptionsManifest);@(_DotKtCompileReference);@(_DotKtRuntimeReference)"
          Outputs="$(DotKtOut)/.stamp">
    <!-- Deletion-safety (#50): the BIR is globbed from $(DotKtOut), which was never cleaned, so a deleted/renamed .kt
         left a stale *.bir.json behind → the deleted class/function survived into the emitted DLL. Wiping the dir on
         every (already-deemed-necessary) recompile guarantees a fresh BIR set with no orphan artifact. This body only
         runs when the Inputs/Outputs check above deems a rebuild needed; the .stamp is recreated at the end and the
         csc placeholder by DotKtIlPlaceholder afterward, so incremental is preserved. -->
    <RemoveDir Directories="$(DotKtOut)" />
    <MakeDir Directories="$(DotKtOut)" />
    <Message Importance="high" Text="DotKt: compiling @(KotlinCompile->Count()) .kt file(s) -> BIR" />
    <!-- $(DotKtKotcOptions): extra raw kotc flags a project may pass through (e.g. compiling the stdlib ITSELF needs
         -Xallow-kotlin-package -opt-in=... ). Space-separated; appended verbatim to the compile command.
         $(DotKtMppFlags) is computed by DotKtComputeCompileOptions above. -->
    <PropertyGroup>
      <_DotKtKlibPathSeparator>$([System.IO.Path]::PathSeparator)</_DotKtKlibPathSeparator>
      <_DotKtFrontendClasspath Condition="'$(DotKtUseDll2Klib)' == 'true'">$(DotKtStdlib)$(_DotKtKlibPathSeparator)@(_DotKtKlibReference->'%(KlibPath)', '$(_DotKtKlibPathSeparator)')</_DotKtFrontendClasspath>
      <_DotKtFrontendClasspath Condition="'$(DotKtUseDll2Klib)' != 'true'">$(DotKtStdlib)</_DotKtFrontendClasspath>
      <_DotKtFrontendEnvironment Condition="'$(DotKtUseDll2Klib)' != 'true'">CLR_TYPES_METADATA=$(DotKtTypeMeta)</_DotKtFrontendEnvironment>
    </PropertyGroup>
    <Exec Command="&quot;$(DotKtCompiler)&quot; @(KotlinCompile->'&quot;%(FullPath)&quot;', ' ') -no-stdlib -classpath &quot;$(_DotKtFrontendClasspath)&quot; -d &quot;$(DotKtOut)&quot; $(DotKtMppFlags) $(DotKtKotcOptions)"
          EnvironmentVariables="$(_DotKtFrontendEnvironment)" />
    <Touch Files="$(DotKtOut)/.stamp" AlwaysCreate="true" />
  </Target>

  <!-- Give csc a trivial valid assembly to produce; ilemit overwrites it. The user's entry (e.g. AppKt) doesn't
       exist in the placeholder, so point csc at the placeholder's Main for this throwaway compile. -->
  <Target Name="DotKtIlPlaceholder" BeforeTargets="CoreCompile" DependsOnTargets="KotlinCompile">
    <PropertyGroup>
      <StartupObject Condition="'$(StartupObject)' != '' or '$(OutputType)' == 'Exe'">_DotKtPlaceholder</StartupObject>
    </PropertyGroup>
    <MakeDir Directories="$(DotKtOut)" />
    <!-- WriteOnlyWhenDifferent (#134): the placeholder body is a CONSTANT, so keep its mtime stable across no-op
         builds — otherwise its bumped timestamp forces CoreCompile (csc) to recompile every single build, defeating
         the whole incremental chain. It flips only if the constant itself ever changes. -->
    <WriteLinesToFile File="$(DotKtOut)/_DotKtPlaceholder.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="public static class _DotKtPlaceholder { public static void Main(string[] a) { } }" />
    <ItemGroup>
      <Compile Include="$(DotKtOut)/_DotKtPlaceholder.cs" />
    </ItemGroup>
  </Target>

  <!-- Incremental (#134): re-lower ONLY when the frontend recompiled ($(DotKtOut)/.stamp bumps) or the bir2cir tool
       itself changed (version proxy). A reference-set change already retriggers KotlinCompile (its Inputs include the
       resolved refs) and thus the .stamp, so the cascade covers it. Keyed off the .stamp — not the *.bir.json glob —
       because target-body items don't exist when MSBuild evaluates the Inputs, and the .stamp is the compile's
       single stable up-to-date marker. Output is $(DotKtCirOut)/.stamp, Touch'd after a successful lowering. -->
  <Target Name="DotKtBir2Cir" BeforeTargets="DotKtIlEmit" DependsOnTargets="KotlinCompile;DotKtResolveReferenceSets"
          Inputs="$(DotKtOut)/.stamp;$(DotKtBir2Cir)" Outputs="$(DotKtCirOut)/.stamp">
    <ItemGroup>
      <_DotKtBir Include="$(DotKtOut)/*.bir.json" />
      <!-- Inputs only.  The exact compile-reference universe was materialized by DotKtResolveReferenceSets. -->
    </ItemGroup>
    <RemoveDir Directories="$(DotKtCirOut)" />
    <MakeDir Directories="$(DotKtCirOut)" />
    <Message Importance="high" Text="DotKt: lowering BIR -> CIR" />
    <Exec Command="dotnet &quot;$(DotKtBir2Cir)&quot; &quot;$(DotKtCirOut)&quot; --compile-refs &quot;$(_DotKtCompileReferences)&quot; @(_DotKtBir->'&quot;%(FullPath)&quot;', ' ')" />
    <Touch Files="$(DotKtCirOut)/.stamp" AlwaysCreate="true" />
  </Target>

  <!-- After CoreCompile, overwrite csc's (placeholder) assembly with one emitted directly as CIL from CIR. The
       copy-local references (the project's package/project references, NOT the BCL, which ilemit resolves by runtime
       reflection) are preloaded into ilemit as references. -->
  <!-- Incremental (#134): re-emit ONLY when the CIR changed ($(DotKtCirOut)/.stamp), the ilemit tool changed, or a
       runtime reference dll changed (a cross-into dependency's new build). Output is the emitted assembly in obj/;
       on a no-op build CoreCompile leaves it untouched (the placeholder .cs is now WriteOnlyWhenDifferent) so it
       stays newer than the CIR stamp and ilemit skips — the emitted dll's timestamp no longer churns every build,
       so a downstream C# ProjectReference stops rebuilding. DotKtResolveReferenceSets is a dependency so the
       @(_DotKtRuntimeReference) items exist when these Inputs are evaluated. -->
  <Target Name="DotKtIlEmit" AfterTargets="CoreCompile" DependsOnTargets="DotKtBir2Cir;DotKtResolveReferenceSets"
          Inputs="$(DotKtCirOut)/.stamp;$(DotKtIlEmit);@(_DotKtRuntimeReference)"
          Outputs="$(IntermediateOutputPath)$(TargetName)$(TargetExt)">
    <ItemGroup>
      <_DotKtCir Include="$(DotKtCirOut)/*.cir.json" />
      <!-- ilemit's refs are the RUNTIME (implementation) assemblies from the copy-local set: the runtime stdlib
           (DotKt.Stdlib, real kotlin.* bodies — resolves kotlin.io.ConsoleKt.println etc.), plus every user
           PackageReference / ProjectReference / explicit <Reference> runtime dll a call may cross into. The
           @Clr-metadata REFERENCE stdlib (DotKt.Private.Stdlib) is a compile-only <Reference Private=false>, so it is
           never copy-local and never reaches ilemit — correct: its throw-stub bodies are a pure metadata surface for
           bir2cir. Framework/targeting-pack assemblies (System.*) are never copy-local either — ilemit resolves the BCL
           by runtime reflection. CopyLocalLockFileAssemblies=true (set above) makes this set complete for a Library. -->
      <!-- The [Kotlin*] round-trip metadata attributes ilemit stamps so this library round-trips (is consumable AS
           KOTLIN by another .ktproj — [KotlinFileClass] restores a file facade's statics as top-level functions,
           [KotlinFunction] restores infix/operator/suspend, etc.) are SYNTHESIZED PER-ASSEMBLY by ilemit (embedded
           internal / CompilerGenerated) — added alongside the NRT System.Runtime.CompilerServices.Nullable*
           attributes (the csc embedded-attribute model; see toolchain/ilemit/Emitter.CompilerServices.cs). So no
           DotKt.Runtime reference is needed (that pre-stdlib runtime DLL is retired). -->
    </ItemGroup>
    <Message Importance="high" Text="DotKt: emitting CIL from CIR -> $(TargetName)$(TargetExt)" />
    <!-- #51: pass the TARGET RID + the SDK's RID fallback graph so ilemit selects the runtimes/<rid>/lib asset the
         TARGET runtime would load (not the build HOST's) when a copy-local package ships multiple RID builds. RAR
         gives ilemit ALL RID assets of a RID-impl package; the tool must pick per the target RID. $(RuntimeIdentifier)
         is empty for a framework-dependent (no-RID) build → ilemit defaults to the host RID (correct). Both properties
         are set by Microsoft.NET.Sdk before this AfterTargets=CoreCompile target runs; $(RuntimeIdentifierGraphPath)
         names the SDK's portable graph (or, under UseRidGraph, the full one — same schema). -->
    <Exec Command="dotnet &quot;$(DotKtIlEmit)&quot; &quot;$(IntermediateOutputPath.TrimEnd('/').TrimEnd('\'))&quot; &quot;$(TargetName)&quot; --runtime-refs &quot;$(_DotKtRuntimeReferences)&quot; --target-rid &quot;$(RuntimeIdentifier)&quot; --rid-graph-path &quot;$(RuntimeIdentifierGraphPath)&quot; @(_DotKtCir->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

  <!-- REVERSE interop (R-1): repoint the emitted dll's BCL TypeRefs off the single System.Private.CoreLib onto the
       real contract assemblies (Object/Task->System.Runtime, List/Dictionary->System.Collections, …) so a C# project
       can <ProjectReference>/<Reference> it at compile time (otherwise CS0012). Uses the same @(ReferencePath) the
       forward path resolves from; runtime is unaffected. Opt out with <DotKtRetarget>false</DotKtRetarget>. -->
  <!-- Incremental (#134): retarget rewrites the emitted dll IN PLACE, so its output can't be the dll (input == output).
       Gate on the dll's timestamp vs an out-of-band $(DotKtRetargetStamp): when ilemit re-emits (dll mtime bumps) this
       re-runs; on a no-op build the dll is untouched and the stamp (Touch'd last, after the in-place rewrite) stays
       newer, so retarget skips and the shipping dll's timestamp is stable across no-op builds. -->
  <Target Name="DotKtRetarget" AfterTargets="DotKtIlEmit"
          Condition="'$(DotKtRetarget)' != 'false'"
          Inputs="$(IntermediateOutputPath)$(TargetName)$(TargetExt);$(DotKtRetargetTool)"
          Outputs="$(DotKtRetargetStamp)">
    <Message Importance="high" Text="DotKt: retargeting BCL refs for compile-time &lt;Reference&gt; -> $(TargetName)$(TargetExt)" />
    <Exec Command="dotnet &quot;$(DotKtRetargetTool)&quot; &quot;$(IntermediateOutputPath)$(TargetName)$(TargetExt)&quot; --compile-refs &quot;$(_DotKtCompileReferences)&quot;" />
    <Touch Files="$(DotKtRetargetStamp)" AlwaysCreate="true" />
  </Target>

  <!-- `dotnet clean` (#161): the DotKt pipeline state under $(BaseIntermediateOutputPath) (the BIR/CIR dirs and the
       injection-metadata / import-list / options / import manifest files) is written by our Exec/WriteLinesToFile
       steps, NOT tracked in @(FileWrites), so CoreClean never removed it — a `dotnet clean` left stale $(DotKtTypeMeta)
       behind and a rebuild reused the stale injection metadata. Wipe all of it before CoreClean so `dotnet clean`
       truly resets the DotKt state and the next build regenerates injection from scratch. -->
  <Target Name="DotKtClean" BeforeTargets="CoreClean">
    <RemoveDir Directories="$(DotKtOut);$(DotKtCirOut);$(DotKtReferenceKlibDir)" />
    <Delete Files="$(DotKtTypeMeta);$(DotKtImportList);$(DotKtOptionsManifest);$(DotKtImportManifest);$(DotKtRetargetStamp)" />
  </Target>
</Project>
