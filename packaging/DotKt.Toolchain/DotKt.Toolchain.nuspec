<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DotKt.Toolchain</id>
    <version>$version$</version>
    <authors>DotKt</authors>
    <description>DotKt compiler toolchain: the Kotlin-&gt;CLR compiler (kotc; JVM, requires a JRE), bir2cir, ilemit, facadegen, retarget, the CLR frontend stdlib klib, and the compile-time stdlib reference assembly (DotKt.Private.Stdlib.dll). The runtime stdlib ships separately as DotKt.Stdlib.</description>
    <tags>kotlin clr dotnet compiler kotlin-$kotlinVersion$</tags>
  </metadata>
  <files>
    <file src="tools/**" target="tools" />
    <file src="build/DotKt.Toolchain.props" target="build/DotKt.Toolchain.props" />
    <file src="build/DotKt.Toolchain.targets" target="build/DotKt.Toolchain.targets" />
  </files>
</package>
