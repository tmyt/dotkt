<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../DotKt.Versions.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>DotKt.Sdk.nuspec</NuspecFile>
    <!-- Version + Kotlin version are single-sourced in packaging/DotKt.Versions.props (imported above);
         the nuspec's $version$ / $kotlinVersion$ tokens are substituted from here. -->
    <NuspecProperties>version=$(Version);kotlinVersion=$(DotKtKotlinVersion);repoCommit=$(RepoCommit)</NuspecProperties>
    <NoWarn>NU5128;NU5100</NoWarn>
  </PropertyGroup>
</Project>
