<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DotKt.Sdk</id>
    <version>$version$</version>
    <authors>DotKt</authors>
    <description>DotKt MSBuild SDK: build Kotlin (.kt) projects to .NET assemblies. Pulls in DotKt.Toolchain + DotKt.Runtime.</description>
    <tags>kotlin clr dotnet msbuild sdk</tags>
    <packageTypes><packageType name="MSBuildSdk" /></packageTypes>
  </metadata>
  <files>
    <file src="Sdk/**" target="Sdk" />
  </files>
</package>
