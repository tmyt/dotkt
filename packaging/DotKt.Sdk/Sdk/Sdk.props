<Project>
  <!-- The base SDK: thin build orchestration. The compiler binaries come from DotKt.Toolchain (injected as an
       implicit build-only reference below) — so a consuming project needs only `<Project Sdk="DotKt.Sdk">` +
       OutputType + TargetFramework. The pre-stdlib DotKt.Runtime DLL is retired (the real CLR stdlib supersedes it). -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <DotKtVersion Condition="'$(DotKtVersion)' == ''">0.9.3</DotKtVersion>
    <!-- We generate the assembly ourselves (kt -> BIR -> CIL); don't let the .NET SDK glob .cs and don't infer
         a language from the project file. -->
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <LanguageTargets Condition="'$(LanguageTargets)' == ''">$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
    <!-- The SDK's reference assembly (obj/ref) is built by csc from our placeholder .cs, so it holds the placeholder
         instead of the Kotlin types ilemit writes into the real dll — a downstream C# <ProjectReference> would bind
         the empty ref assembly (CS0246). Disable it so consumers reference the real, retargeted output. -->
    <ProduceReferenceAssembly Condition="'$(ProduceReferenceAssembly)' == ''">false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Implicit reference: the toolchain (build-only). -->
  <ItemGroup>
    <PackageReference Include="DotKt.Toolchain" Version="$(DotKtVersion)" PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>

  <!-- Every .kt under the project is a Kotlin source. -->
  <ItemGroup>
    <KotlinCompile Include="**/*.kt" Exclude="$(BaseIntermediateOutputPath)**;$(IntermediateOutputPath)**;bin/**;obj/**" />
  </ItemGroup>

  <!-- Teach VS's fast up-to-date check (FUTDC) that .kt files are build inputs. FUTDC runs BEFORE MSBuild on
       Build (Ctrl+B) / Run (F5) and only tracks Compile/Content/None/references + explicit UpToDateCheckInput
       items. Our sources live in the custom KotlinCompile item, which FUTDC doesn't know about — so without this it
       sees no tracked input change after a .kt edit, declares the project up-to-date, and skips the build (running
       a stale assembly). Mapping KotlinCompile -> UpToDateCheckInput makes "edit .kt -> Ctrl+B/Run rebuilds" reliable.
       Must be a top-level ItemGroup (evaluation time): FUTDC reads evaluated items, not target-produced ones. -->
  <ItemGroup>
    <UpToDateCheckInput Include="@(KotlinCompile)" />
  </ItemGroup>
</Project>
