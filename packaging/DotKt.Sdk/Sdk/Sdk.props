<Project>
  <!-- The base SDK: thin build orchestration. The compiler binaries come from DotKt.Toolchain and the runtime
       from DotKt.Runtime, both injected as implicit references below — so a consuming project needs only
       `<Project Sdk="DotKt.Sdk">` + OutputType + TargetFramework. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <DotKtVersion Condition="'$(DotKtVersion)' == ''">0.9.0</DotKtVersion>
    <!-- We generate the assembly ourselves (kt -> BIR -> CIL); don't let the .NET SDK glob .cs and don't infer
         a language from the project file. -->
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <LanguageTargets Condition="'$(LanguageTargets)' == ''">$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
  </PropertyGroup>

  <!-- Implicit references: the toolchain (build-only) and the runtime (a real reference). -->
  <ItemGroup>
    <PackageReference Include="DotKt.Toolchain" Version="$(DotKtVersion)" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="DotKt.Runtime" Version="$(DotKtVersion)" />
  </ItemGroup>

  <!-- Every .kt under the project is a Kotlin source. -->
  <ItemGroup>
    <DotKtCompile Include="**/*.kt" Exclude="$(BaseIntermediateOutputPath)**;$(IntermediateOutputPath)**;bin/**;obj/**" />
  </ItemGroup>
</Project>
