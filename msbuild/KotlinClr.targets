<!-- kotlin/clr MSBuild integration: compile .kt -> .cs with our backend, then let the C# toolchain
     finish the build. Import this from a .ktproj. -->
<Project>

  <PropertyGroup>
    <KotlinClrRoot Condition="'$(KotlinClrRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</KotlinClrRoot>
    <KotlinClrLauncher Condition="'$(KotlinClrLauncher)' == ''">$(KotlinClrRoot)/compiler/build/install/compiler/bin/compiler</KotlinClrLauncher>
    <KotlinStdlib Condition="'$(KotlinStdlib)' == ''">$(KotlinClrRoot)/runtime/kotlin/kotlin-stdlib.jar</KotlinStdlib>
    <!-- Generated files live under obj/ (which the .kt glob excludes), not the source tree. -->
    <KotlinClrOut>$(BaseIntermediateOutputPath)kotlin-cs</KotlinClrOut>
    <KotlinClrFacadeGen>$(KotlinClrRoot)/build/facadegen-bin/facadegen.dll</KotlinClrFacadeGen>
    <KotlinClrFacadeOut>$(BaseIntermediateOutputPath)kotlin-facades</KotlinClrFacadeOut>
    <!-- Backend: "cs" (default: kt->C#->csc) or "il" (kt->BIR->ilemit, emit CIL directly). -->
    <KotlinClrBackend Condition="'$(KotlinClrBackend)' == ''">cs</KotlinClrBackend>
    <KotlinClrIlEmit>$(KotlinClrRoot)/build/ilemit-bin/ilemit.dll</KotlinClrIlEmit>
    <!-- We generate the C# ourselves; don't let the SDK glob .cs/.kt. -->
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <!-- A .ktproj has no implicit language; build the generated C# with the C# language targets. -->
    <LanguageTargets Condition="'$(LanguageTargets)' == ''">$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
  </PropertyGroup>

  <!-- By default every .kt under the project is a Kotlin source. -->
  <ItemGroup>
    <KotlinCompile Include="**/*.kt" Exclude="$(BaseIntermediateOutputPath)**;$(IntermediateOutputPath)**;bin/**;obj/**" />
  </ItemGroup>

  <!-- Bootstrap: build the kotlin/clr compiler launcher if it isn't there yet. -->
  <Target Name="EnsureKotlinClrCompiler" BeforeTargets="KotlinClrCompile" Condition="!Exists('$(KotlinClrLauncher)')">
    <Message Importance="high" Text="kotlin/clr: building compiler launcher (first run)..." />
    <Exec Command="&quot;$(KotlinClrRoot)/gradlew&quot; -q :compiler:installDist" WorkingDirectory="$(KotlinClrRoot)" />
  </Target>

  <!-- Auto-generate Kotlin façades for the .NET types listed via <KotlinClrFacade Include="..."/>. -->
  <Target Name="EnsureFacadeGen" BeforeTargets="KotlinClrFacades"
          Condition="'@(KotlinClrFacade)' != '' and !Exists('$(KotlinClrFacadeGen)')">
    <Message Importance="high" Text="kotlin/clr: building façade generator (first run)..." />
    <Exec Command="dotnet build &quot;$(KotlinClrRoot)/tools/facadegen&quot; -c Release -o &quot;$(KotlinClrRoot)/build/facadegen-bin&quot; -v q --nologo" />
  </Target>

  <Target Name="KotlinClrFacades" BeforeTargets="KotlinClrCompile" Condition="'@(KotlinClrFacade)' != ''">
    <MakeDir Directories="$(KotlinClrFacadeOut)" />
    <Message Importance="high" Text="kotlin/clr: generating façades for @(KotlinClrFacade->'%(Identity)', ', ')" />
    <Exec Command="dotnet &quot;$(KotlinClrFacadeGen)&quot; &quot;$(KotlinClrFacadeOut)&quot; @(KotlinClrFacade->'%(Identity)', ' ')" />
    <ItemGroup>
      <KotlinCompile Include="$(KotlinClrFacadeOut)/clr/*.kt" />
    </ItemGroup>
  </Target>

  <!-- Compile all .kt to .cs, then hand the generated C# to CoreCompile. -->
  <Target Name="KotlinClrCompile" BeforeTargets="CoreCompile"
          Inputs="@(KotlinCompile)" Outputs="$(KotlinClrOut)/.stamp">
    <MakeDir Directories="$(KotlinClrOut)" />
    <Message Importance="high" Text="kotlin/clr: compiling @(KotlinCompile->Count()) .kt file(s) -> C#" />
    <Exec Command="&quot;$(KotlinClrLauncher)&quot; @(KotlinCompile->'&quot;%(FullPath)&quot;', ' ') -no-stdlib -classpath &quot;$(KotlinStdlib)&quot; -d &quot;$(KotlinClrOut)&quot;" />
    <Touch Files="$(KotlinClrOut)/.stamp" AlwaysCreate="true" />
  </Target>

  <!-- cs backend: add generated C# to the compile set (before CoreCompile). -->
  <Target Name="KotlinClrCollect" BeforeTargets="CoreCompile" DependsOnTargets="KotlinClrCompile"
          Condition="'$(KotlinClrBackend)' == 'cs'">
    <ItemGroup>
      <Compile Include="$(KotlinClrOut)/*.cs" />
    </ItemGroup>
  </Target>

  <!-- il backend: give csc a trivial valid assembly to produce; ilemit overwrites it afterwards. -->
  <Target Name="KotlinClrIlPlaceholder" BeforeTargets="CoreCompile" DependsOnTargets="KotlinClrCompile"
          Condition="'$(KotlinClrBackend)' == 'il'">
    <MakeDir Directories="$(KotlinClrOut)" />
    <WriteLinesToFile File="$(KotlinClrOut)/_IlPlaceholder.cs" Overwrite="true"
                      Lines="public static class _IlPlaceholder { public static void Main(string[] a) { } }" />
    <ItemGroup>
      <Compile Include="$(KotlinClrOut)/_IlPlaceholder.cs" />
    </ItemGroup>
  </Target>

  <!-- il backend: bootstrap ilemit, then overwrite the compiled assembly with one emitted directly
       as CIL from BIR (no C#). Runs after CoreCompile so it replaces csc's (placeholder) output. -->
  <Target Name="EnsureIlEmit" BeforeTargets="KotlinClrIlEmit"
          Condition="'$(KotlinClrBackend)' == 'il' and !Exists('$(KotlinClrIlEmit)')">
    <Message Importance="high" Text="kotlin/clr: building ilemit (first run)..." />
    <Exec Command="dotnet build &quot;$(KotlinClrRoot)/tools/ilemit&quot; -c Release -o &quot;$(KotlinClrRoot)/build/ilemit-bin&quot; -v q --nologo" />
  </Target>

  <Target Name="KotlinClrIlEmit" AfterTargets="CoreCompile" DependsOnTargets="KotlinClrCompile"
          Condition="'$(KotlinClrBackend)' == 'il'">
    <ItemGroup>
      <_KotlinBir Include="$(KotlinClrOut)/*.bir.json" />
    </ItemGroup>
    <Message Importance="high" Text="kotlin/clr: emitting CIL directly from BIR -> $(TargetName)$(TargetExt)" />
    <Exec Command="dotnet &quot;$(KotlinClrIlEmit)&quot; &quot;$(IntermediateOutputPath.TrimEnd('/').TrimEnd('\'))&quot; &quot;$(TargetName)&quot; @(_KotlinBir->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

</Project>
