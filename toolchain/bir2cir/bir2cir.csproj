<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bir2cir</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ref-common/ManagedReferenceCatalog.cs" Link="ManagedReferenceCatalog.cs" />
    <!-- Shared single-source Type read/write helper of the BIR/CIR freeze (#37). Linked (not a project ref)
         so all three C# tools compile the SAME contract with no build-order dependency. -->
    <Compile Include="../bir-common/TypeNode.cs" Link="TypeNode.cs" />
    <!-- Shared JSON depth bound for BIR/CIR read/write (#147: default MaxDepth 64 crashes on deeply-nested lambdas). -->
    <Compile Include="../bir-common/BirJson.cs" Link="BirJson.cs" />
    <!-- Shared layer-agnostic IR SANITY invariants (#84 P4 / #112 P4). Run by BOTH bir2cir (on its CIR output) and
         ilemit (at the head of EmitAssembly); scripts/verify-sanity.py mirrors them offline. -->
    <Compile Include="../bir-common/IrSanity.cs" Link="IrSanity.cs" />
    <!-- Shared "may this type be an instance field?" oracle + the diagnostics its three minting sites share
         (suspend SM spills, suspend-lambda captures, closure captures). bir2cir is the only tool that mints
         heap storage for a Kotlin value, so it is the only linker. -->
    <Compile Include="../bir-common/FieldLegality.cs" Link="FieldLegality.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read the metadata-only reference stdlib (throw-stub bodies, kotlin.* signatures) WITHOUT a runtime load:
         Assembly.LoadFrom chokes (TypeLoadException) on it; MetadataLoadContext reads its metadata cleanly. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
</Project>
