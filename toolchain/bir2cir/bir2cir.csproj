<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bir2cir</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ref-common/ManagedReferenceCatalog.cs" Link="ManagedReferenceCatalog.cs" />
    <!-- Shared single-source Type read/write helper of the BIR/CIR freeze (#37). Linked (not a project ref)
         so all three C# tools compile the SAME contract with no build-order dependency. -->
    <Compile Include="../bir-common/TypeNode.cs" Link="TypeNode.cs" />
    <!-- Shared #370 scalar member reference: the ONE fully resolved external-member identity bir2cir authors and
         ilemit looks up exactly. Linked for the same reason as TypeNode — one compiled contract, no build order. -->
    <Compile Include="../bir-common/MemberRefNode.cs" Link="MemberRefNode.cs" />
    <!-- Shared JSON depth bound for BIR/CIR read/write (#147: default MaxDepth 64 crashes on deeply-nested lambdas). -->
    <Compile Include="../bir-common/BirJson.cs" Link="BirJson.cs" />
    <!-- Shared layer-agnostic IR SANITY invariants (#84 P4 / #112 P4). Run by BOTH bir2cir (on its CIR output) and
         ilemit (at the head of EmitAssembly); scripts/verify-sanity.py mirrors them offline. -->
    <Compile Include="../bir-common/IrSanity.cs" Link="IrSanity.cs" />
    <!-- Shared mutable/read-only collection face relation: bir2cir STATES the read-only sibling in `interfaces`,
         the IrSanity gate above REFUSES a document that omits one. One table so the two cannot drift. -->
    <Compile Include="../bir-common/CollectionViewFaces.cs" Link="CollectionViewFaces.cs" />
    <!-- Shared "may this type be an instance field?" oracle + the diagnostics its three minting sites share
         (suspend SM spills, suspend-lambda captures, closure captures). bir2cir is the only tool that mints
         heap storage for a Kotlin value, so it is the only linker. -->
    <Compile Include="../bir-common/FieldLegality.cs" Link="FieldLegality.cs" />
    <!-- Q1 (re-readable) and Q2 (droppable) of the four value questions — the two whose answers are pure facts
         about the node vocabulary. The file heads the roster of all four and where the other two live. -->
    <Compile Include="../bir-common/ValueStability.cs" Link="ValueStability.cs" />
    <!-- Raw ECMA metadata validation shared with dll2klib. Reflection does not expose every legal
         CustomAttribute parent (InterfaceImpl/GenericParamConstraint), so trust-boundary checks cannot use MLC. -->
    <Compile Include="../dll2klib/MetadataAttributes.cs" Link="MetadataAttributes.cs" />
    <!-- Shared node-local "what type does this expression node produce?" derivation — the suspend lowering's
         operand plans and the call-evaluation plan's address pins both mint locals and need one answer. -->
    <Compile Include="../bir-common/NodeType.cs" Link="NodeType.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read the metadata-only reference stdlib (throw-stub bodies, kotlin.* signatures) WITHOUT a runtime load:
         Assembly.LoadFrom chokes (TypeLoadException) on it; MetadataLoadContext reads its metadata cleanly. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
</Project>
