<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shipped tool identity is the DotKt release identity, not the Microsoft.NET.Sdk default 1.0.0. -->
  <Import Project="../../packaging/DotKt.Versions.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dll2klib</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../bir-common/TypeNode.cs" Link="TypeNode.cs" />
    <Compile Include="../bir-common/TypeNode.Model.Generated.cs" Link="TypeNode.Model.Generated.cs" />
    <Compile Include="../bir-common/TypeNode.Json.Generated.cs" Link="TypeNode.Json.Generated.cs" />
    <Compile Include="../bir-common/SourceMetadata.Model.Generated.cs" Link="SourceMetadata.Model.Generated.cs" />
    <Compile Include="../bir-common/SourceMetadata.Json.Generated.cs" Link="SourceMetadata.Json.Generated.cs" />
    <Compile Include="../bir-common/SourceMetadata.MessagePack.Generated.cs" Link="SourceMetadata.MessagePack.Generated.cs" />
    <Compile Include="../bir-common/BirCarrier.MessagePack.cs" Link="BirCarrier.MessagePack.cs" />
    <Compile Include="../bir-common/IrMessagePack.cs" Link="IrMessagePack.cs" />
    <Compile Include="../bir-common/FunctionPointerVocabulary.cs" Link="FunctionPointerVocabulary.cs" />
    <Compile Include="../bir-common/NullableRepresentationFrame.cs" Link="NullableRepresentationFrame.cs" />
    <Compile Include="../bir-common/BirJson.cs" Link="BirJson.cs" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <Protobuf Include="KlibMetadata.proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="[3.1.12]" />
  </ItemGroup>
</Project>
