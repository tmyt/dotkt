<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../packaging/DotKt.Versions.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DotKt.Build</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSBuild supplies its own task API; do not ship a second MSBuild runtime. -->
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" Private="false" />
    <!-- Use the selected SDK's public resource-generation API, not a second compiler distribution. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynTargetsPath)/bincore/Microsoft.CodeAnalysis.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynTargetsPath)/bincore/Microsoft.CodeAnalysis.CSharp.dll" Private="false" />
    <Compile Include="../ilemit/SdkAssemblyOptions.cs" Link="SdkAssemblyOptions.cs" />
    <Compile Include="../ilemit/AssemblyVersions.cs" Link="AssemblyVersions.cs" />
  </ItemGroup>
</Project>
