<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The Kotlin file class has no namespace; its synthesized Main is the entry point. -->
    <StartupObject>M0Kt</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pull in the C# emitted by the kotlin/clr compiler. -->
    <Compile Include="../../build/clr-out/M0.cs" />
  </ItemGroup>

</Project>
