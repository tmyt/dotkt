<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <!-- Façade-FREE: these .NET types are injected straight into the compiler frontend. No .kt façade
       is generated; `import clrgen.X` just resolves. -->
  <ItemGroup>
    <KotlinClrType Include="System.Text.StringBuilder" />
    <KotlinClrType Include="System.Math" />
  </ItemGroup>

  <Import Project="../../msbuild/KotlinClr.targets" />

</Project>
