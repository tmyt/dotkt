<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <!-- Façade-FREE, import-driven: the .kt sources are scanned for `import System.X` and those types are
       injected straight into the compiler frontend. No <KotlinClrType>, no .kt façade — the import is enough. -->

  <Import Project="../../toolchain/KotlinClr.targets" />

</Project>
