<!-- WINDOWS-ONLY. Build on Windows: it reuses the SAME Kotlin-emitted app.cs as the Avalonia sample.
     On Linux this will not restore/build (the net*-windows desktop pack is Windows-only). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UiRuntime.wpf.cs" />
    <Compile Include="../../build/clr-win/app.cs" />
  </ItemGroup>

</Project>
