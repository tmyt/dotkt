<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A referenced library, not an exe — no StartupObject. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- FORWARD ProjectReference: Kotlin consumes the C# project's types (import Theme.Palette just works). -->
  <ItemGroup>
    <ProjectReference Include="../cslib/cslib.csproj" />
  </ItemGroup>

  <Import Project="../../../msbuild/KotlinClr.targets" />
</Project>
