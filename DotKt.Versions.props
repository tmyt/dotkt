<!-- Shared version for all DotKt packages (Sdk / Toolchain / Runtime / Templates).
     The PACKAGE version is plain SemVer 0.9.0 with NO build metadata: NuGet's template engine (dotnet new install
     from a feed) does a strict version comparison and rejects a package whose nupkg version is `0.9.0+kotlin-2.2.0`
     while the feed index lists `0.9.0`. So the embedded Kotlin compiler version lives in the assembly
     InformationalVersion + a package tag instead of the version string. AssemblyVersion/FileVersion = 0.9.0.0. -->
<Project>
  <PropertyGroup>
    <DotKtVersionPrefix>0.9.0</DotKtVersionPrefix>
    <DotKtKotlinVersion>2.2.0</DotKtKotlinVersion>
    <Version>$(DotKtVersionPrefix)</Version>
    <InformationalVersion>$(DotKtVersionPrefix)+kotlin-$(DotKtKotlinVersion)</InformationalVersion>
    <PackageTags>kotlin clr dotnet kotlin-$(DotKtKotlinVersion)</PackageTags>
    <AssemblyVersion>$(DotKtVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(DotKtVersionPrefix).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
