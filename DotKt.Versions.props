<!-- Shared version for all DotKt packages (Sdk / Toolchain / Runtime). The package/informational version carries
     the embedded Kotlin compiler version as SemVer build metadata: 1.0.0+kotlin-2.2.0. AssemblyVersion/FileVersion
     take the numeric prefix (1.0.0.0); +metadata is allowed only in Package/Informational versions. -->
<Project>
  <PropertyGroup>
    <DotKtVersionPrefix>0.9.0</DotKtVersionPrefix>
    <DotKtKotlinVersion>2.2.0</DotKtKotlinVersion>
    <Version>$(DotKtVersionPrefix)+kotlin-$(DotKtKotlinVersion)</Version>
    <AssemblyVersion>$(DotKtVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(DotKtVersionPrefix).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
