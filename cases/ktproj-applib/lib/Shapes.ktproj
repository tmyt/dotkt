<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Kotlin LIBRARY: OutputType=Library makes DotKt emit Shapes.dll (no entry point). The emitted dll
       carries the [Kotlin*] round-trip metadata + retargeted BCL refs, so a consumer can reference it as a
       real .NET assembly and re-import its declarations as Kotlin. No StartupObject (it is not an exe). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
