<Project Sdk="Microsoft.NET.Sdk">

  <!-- #25 LIBRARY: a Kotlin lib exporting a generic-overload factory set (`atomic`/`arrOf`). OutputType=Library
       emits Lib.dll with the [Kotlin*] round-trip metadata; the app references it and re-imports `genov.*` AS KOTLIN. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
