<!-- In-repo DEV entry for the kt -> BIR -> CIL build. The shipping SDK and this file share ONE pipeline,
     packaging/DotKt.Toolchain/build/DotKt.Toolchain.targets; this file just (1) points the $(DotKt*) tool vars at the in-repo
     source builds, (2) bootstraps those tools the first time (the shipping SDK gets them from NuGet instead), and
     (3) sets the project hygiene the SDK's Sdk.props sets. Sample .ktproj import this via <Import .../KotlinClr.targets>. -->
<Project>

  <PropertyGroup>
    <KotlinClrRoot Condition="'$(KotlinClrRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</KotlinClrRoot>

    <!-- Tool locations: the in-repo source builds (the shared pipeline reads these $(DotKt*) vars). -->
    <DotKtCompiler Condition="'$(DotKtCompiler)' == ''">$(KotlinClrRoot)/toolchain/kotc/build/install/kotc/bin/kotc</DotKtCompiler>
    <!-- kotc -classpath: the CLR FRONTEND jar built FROM our CLR stdlib sources (scripts/build-clr-stdlib-frontend.sh),
         REPLACING the JVM kotlin-stdlib.jar whose java.util.* typealiases leaked into the frontend. kotlin.* resolves
         from THIS jar (full Kotlin semantics), never from facadegen. Same input scripts/verify-il.sh + dotkt.sh use. -->
    <DotKtStdlib Condition="'$(DotKtStdlib)' == ''">$(KotlinClrRoot)/build/clr-stdlib-frontend-jvm/kotlin-stdlib-clr-frontend.jar</DotKtStdlib>
    <DotKtFacadeGen Condition="'$(DotKtFacadeGen)' == ''">$(KotlinClrRoot)/build/facadegen-bin/facadegen.dll</DotKtFacadeGen>
    <DotKtBir2Cir Condition="'$(DotKtBir2Cir)' == ''">$(KotlinClrRoot)/build/bir2cir-bin/bir2cir.dll</DotKtBir2Cir>
    <DotKtIlEmit Condition="'$(DotKtIlEmit)' == ''">$(KotlinClrRoot)/build/ilemit-bin/ilemit.dll</DotKtIlEmit>
    <DotKtRetargetTool Condition="'$(DotKtRetargetTool)' == ''">$(KotlinClrRoot)/build/retarget-bin/retarget.dll</DotKtRetargetTool>
    <!-- The CLR stdlib (canonical build under runtime/stdlib/, mirrors scripts/verify-il.sh + dotkt.sh): the RUNTIME
         assembly (real Kotlin bodies) is copy-local and ilemit's runtime ref; the @Clr-metadata REFERENCE assembly
         feeds bir2cir's @ClrTypeAlias/@ClrIntrinsic substitution (added as a non-copy Reference below, handed to
         bir2cir by the shared DotKtBir2Cir target). The OLD build/dotkt-stdlib (build-dotkt-stdlib.sh) is retired. -->
    <DotKtStdlibAsm Condition="'$(DotKtStdlibAsm)' == ''">$(KotlinClrRoot)/build/clr-stdlib-rt/dll/DotKt.Stdlib.dll</DotKtStdlibAsm>
    <DotKtRefAsm Condition="'$(DotKtRefAsm)' == ''">$(KotlinClrRoot)/build/clr-stdlib/dll/DotKt.Private.Stdlib.dll</DotKtRefAsm>
    <KotlinClrFacadeOut>$(BaseIntermediateOutputPath)kotlin-facades</KotlinClrFacadeOut>

    <!-- Project hygiene the shipping SDK applies via Sdk.props: we generate the assembly ourselves (kt -> BIR ->
         CIL), so don't let the .NET SDK glob .cs / infer a language, and don't produce a (placeholder) ref assembly
         a downstream C# <ProjectReference> would wrongly bind. -->
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <LanguageTargets Condition="'$(LanguageTargets)' == ''">$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
    <ProduceReferenceAssembly Condition="'$(ProduceReferenceAssembly)' == ''">false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Every .kt under the project is a Kotlin source; teach VS's fast up-to-date check that they are build inputs. -->
  <ItemGroup>
    <KotlinCompile Include="**/*.kt" Exclude="$(BaseIntermediateOutputPath)**;$(IntermediateOutputPath)**;bin/**;obj/**" />
    <UpToDateCheckInput Include="@(KotlinCompile)" />
  </ItemGroup>

  <!-- DotKt.Runtime carries the (legacy) runtime helpers. NOTE: it does NOT define the [Kotlin*] round-trip metadata
       attribute types — ilemit SYNTHESIZES those per-assembly (embedded internal / CompilerGenerated, see
       toolchain/ilemit/Emitter.CompilerServices.cs), so round-tripping does not depend on this reference. Referencing
       it puts its runtime helpers on @(ReferencePath) for ilemit + the consumer's facadegen + runtime. (Those runtime
       helpers are being retired now the real stdlib supersedes them.) The shipping SDK gets this via a
       <PackageReference>. Opt out with <KotlinClrRuntimeRef>false</...>. -->
  <ItemGroup Condition="'$(KotlinClrRuntimeRef)' != 'false' and Exists('$(KotlinClrRoot)/build/dotkt-runtime/DotKt.Runtime.dll')">
    <Reference Include="DotKt.Runtime">
      <HintPath>$(KotlinClrRoot)/build/dotkt-runtime/DotKt.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- DotKt.Stdlib: real-Kotlin stdlib ops migrated off the COLLECTION_OPS lowering (see EnsureDotKtStdlib below).
       Referencing it puts it on @(ReferencePath) so the facadegen asm-scan injects its ops and ilemit resolves them. -->
  <ItemGroup Condition="'$(KotlinClrStdlibRef)' != 'false' and Exists('$(DotKtStdlibAsm)')">
    <Reference Include="DotKt.Stdlib">
      <HintPath>$(DotKtStdlibAsm)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The @Clr-metadata REFERENCE stdlib (DotKt.Private.Stdlib): bir2cir reads its @ClrTypeAlias/@ClrIntrinsic labels
       to lower kotlin.* tokens + member calls. NOT copy-local (compile-time only; DotKt.Stdlib above is the runtime).
       The shared DotKtBir2Cir target picks it up from @(ReferencePath) by file name and hands it to bir2cir. -->
  <ItemGroup Condition="'$(KotlinClrStdlibRef)' != 'false' and Exists('$(DotKtRefAsm)')">
    <Reference Include="DotKt.Private.Stdlib">
      <HintPath>$(DotKtRefAsm)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Bootstrap: build each tool from source the first time it is missing (the shipping SDK gets them from NuGet).
       Each hooks just before the shared-pipeline target that first needs it. -->
  <Target Name="EnsureKotlinClrCompiler" BeforeTargets="DotKtInjectTypes" Condition="!Exists('$(DotKtCompiler)')">
    <Message Importance="high" Text="kotlin/clr: building compiler launcher (first run)..." />
    <Exec Command="&quot;$(KotlinClrRoot)/gradlew&quot; -q :kotc:installDist" WorkingDirectory="$(KotlinClrRoot)" />
  </Target>
  <Target Name="EnsureFacadeGen" BeforeTargets="DotKtInjectTypes" Condition="!Exists('$(DotKtFacadeGen)')">
    <Message Importance="high" Text="kotlin/clr: building facadegen (first run)..." />
    <Exec Command="dotnet build &quot;$(KotlinClrRoot)/toolchain/facadegen&quot; -c Release -o &quot;$(KotlinClrRoot)/build/facadegen-bin&quot; -v q --nologo" />
  </Target>
  <Target Name="EnsureIlEmit" BeforeTargets="DotKtIlEmit" Condition="!Exists('$(DotKtIlEmit)')">
    <Message Importance="high" Text="kotlin/clr: building ilemit (first run)..." />
    <Exec Command="dotnet build &quot;$(KotlinClrRoot)/toolchain/ilemit&quot; -c Release -o &quot;$(KotlinClrRoot)/build/ilemit-bin&quot; -v q --nologo" />
  </Target>
  <Target Name="EnsureBir2Cir" BeforeTargets="DotKtBir2Cir" Condition="!Exists('$(DotKtBir2Cir)')">
    <Message Importance="high" Text="kotlin/clr: building bir2cir (first run)..." />
    <Exec Command="dotnet build &quot;$(KotlinClrRoot)/toolchain/bir2cir&quot; -c Release -o &quot;$(KotlinClrRoot)/build/bir2cir-bin&quot; -v q --nologo" />
  </Target>
  <Target Name="EnsureRetarget" BeforeTargets="DotKtRetarget" Condition="'$(DotKtRetarget)' != 'false' and !Exists('$(DotKtRetargetTool)')">
    <Message Importance="high" Text="kotlin/clr: building retarget (first run)..." />
    <Exec Command="dotnet build &quot;$(KotlinClrRoot)/toolchain/retarget&quot; -c Release -o &quot;$(KotlinClrRoot)/build/retarget-bin&quot; -v q --nologo" />
  </Target>
  <!-- The CLR frontend stdlib jar (kotc -classpath): build once from our CLR stdlib sources if missing. This is the
       input that replaces the JVM kotlin-stdlib.jar; the shipping SDK ships it inside DotKt.Toolchain. -->
  <Target Name="EnsureKotlinClrFrontendJar" BeforeTargets="DotKtInjectTypes"
          Condition="!Exists('$(DotKtStdlib)') and Exists('$(KotlinClrRoot)/scripts/build-clr-stdlib-frontend.sh')">
    <Message Importance="high" Text="kotlin/clr: building CLR frontend stdlib jar (first run)..." />
    <Exec Command="bash &quot;$(KotlinClrRoot)/scripts/build-clr-stdlib-frontend.sh&quot;" WorkingDirectory="$(KotlinClrRoot)" />
  </Target>

  <!-- The CLR stdlib ref/rt assemblies are the canonical CACHED builds (scripts/build-clr-stdlib{,-runtime}.sh in emit
       mode): the runtime carries the real Kotlin bodies, the reference carries the @Clr metadata. Do NOT auto-rebuild
       them here (the runtime emit is the slow, blocker-prone path; the OLD build-dotkt-stdlib.sh bootstrap that rm'd
       and rebuilt the cache is RETIRED); fail clearly if the cached pair is missing. The shipping SDK would supply the
       runtime stdlib via a PackageReference instead. Opt out of referencing it with KotlinClrStdlibRef=false. -->
  <Target Name="EnsureDotKtStdlib" BeforeTargets="DotKtInjectTypes"
          Condition="'$(KotlinClrStdlibRef)' != 'false' and !Exists('$(DotKtStdlibAsm)')">
    <Error Text="kotlin/clr: missing $(DotKtStdlibAsm). Build the CLR stdlib once with: scripts/build-clr-stdlib.sh --emit &amp;&amp; scripts/build-clr-stdlib-runtime.sh --emit (or set &lt;KotlinClrStdlibRef&gt;false&lt;/KotlinClrStdlibRef&gt; to skip it)." />
  </Target>

  <!-- Auto-generate Kotlin façades for the .NET types listed via <KotlinClrFacade Include="..."/> and feed them to
       the compile (a dev convenience; the C-2 import scan covers most cases without it). -->
  <Target Name="KotlinClrFacades" BeforeTargets="DotKtInjectTypes" Condition="'@(KotlinClrFacade)' != ''">
    <MakeDir Directories="$(KotlinClrFacadeOut)" />
    <Message Importance="high" Text="kotlin/clr: generating façades for @(KotlinClrFacade->'%(Identity)', ', ')" />
    <Exec Command="dotnet &quot;$(DotKtFacadeGen)&quot; &quot;$(KotlinClrFacadeOut)&quot; @(KotlinClrFacade->'%(Identity)', ' ')" />
    <ItemGroup>
      <KotlinCompile Include="$(KotlinClrFacadeOut)/clr/*.kt" />
    </ItemGroup>
  </Target>

  <Import Project="$(KotlinClrRoot)/packaging/DotKt.Toolchain/build/DotKt.Toolchain.targets" />
</Project>
