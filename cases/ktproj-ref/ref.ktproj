<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <!-- Declare .NET types to expose to Kotlin; façades are auto-generated during the build. -->
  <ItemGroup>
    <KotlinClrFacade Include="System.Text.StringBuilder" />
  </ItemGroup>

  <Import Project="../KotlinClr.targets" />

</Project>
