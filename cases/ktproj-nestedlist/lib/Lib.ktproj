<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Kotlin LIBRARY nesting kotlin.collections.* INSIDE a user generic (`Box<List<T>>`) (#29). OutputType=Library
       emits Lib.dll carrying the [Kotlin*] round-trip metadata incl. [KotlinCollectionIdentity] on the collapsed
       nested-collection slots; facadegen restores List vs MutableList from that stamp. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
