<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Kotlin APP that references the Kotlin LIBRARY through <ProjectReference>. Lib.ktproj builds first; its Lib.dll
       lands on the app's @(ReferencePath), where facadegen reads the generic members and a DIRECT read of one whose
       return is the owner's type variable must surface the receiver's concrete instantiation (#33). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../lib/Lib.ktproj" />
  </ItemGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
