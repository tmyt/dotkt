<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Kotlin LIBRARY whose public API takes kotlin.collections.* params (#27). OutputType=Library emits Lib.dll
       carrying the [Kotlin*] round-trip metadata; the collection params surface as their BCL alias interfaces. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
