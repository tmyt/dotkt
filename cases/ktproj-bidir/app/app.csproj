<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- REVERSE ProjectReference: a plain C# project referencing a Kotlin .ktproj at compile time.
       Works because klib's output is retargeted to real contract assemblies (retarget / R-1). -->
  <ItemGroup>
    <ProjectReference Include="../klib/klib.ktproj" />
  </ItemGroup>
</Project>
