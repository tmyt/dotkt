<Project Sdk="Microsoft.NET.Sdk">

  <!-- #25 RESIDUAL: a Kotlin APP referencing the MULTIPLATFORM `genovc` Kotlin LIBRARY through <ProjectReference>.
       `dotnet build` builds Lib.ktproj first; its emitted Lib.dll lands on @(ReferencePath), the app's import-scan +
       facadegen inject `genovc.*` (including the common file class GenovCommonKt), and bir2cir must stamp the resolved
       sig on the generic `arrOfNulls`/`refOf` cross-module calls so ilemit binds the correct overload. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../lib/Lib.ktproj" />
  </ItemGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
