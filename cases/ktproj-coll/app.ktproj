<Project Sdk="Microsoft.NET.Sdk">

  <!-- A practical collections app consuming the real CLR stdlib (DotKt.Stdlib.dll). The KotlinClr.targets auto-
       reference the runtime + reference stdlib; bir2cir attributes referenced top-level stdlib funs to their
       file-class owner, and ilemit resolves them against the runtime assembly. `dotnet run` asserts the output. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <Import Project="../KotlinClr.targets" />

</Project>
