<Project Sdk="Microsoft.NET.Sdk">

  <!-- #17 LIBRARY: a Kotlin lib whose package is `kotlinx.cell`. OutputType=Library emits Cell.dll with the
       [Kotlin*] round-trip metadata; the app references it and re-imports `kotlinx.cell.Cell` AS KOTLIN. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
