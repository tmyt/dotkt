<Project Sdk="Microsoft.NET.Sdk">

  <!-- #15 EMIT-HALF: a Kotlin APP whose recursive `**/*.kt` glob pulls in the NESTED lib/Demo.kt (so the app
       compiles `demo.Plain`/`demo.hello` itself) AND that <ProjectReference>s the same lib (so Demo.dll, which
       exports the same identities, is on @(ReferencePath)). The frontend suppresses the injected copy (source
       wins); bir2cir must prefer the LOCAL BIR type over the referenced dll — a local `new demo.Plain`, not a
       `newClr` against Demo.dll. The <KotlinCompile Remove> keeps the lib's build outputs (lib/bin, lib/obj —
       NOT covered by the top-level bin/obj exclude) out of the app's source set; lib/Demo.kt itself stays in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>AppKt</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="lib/Demo.ktproj" />
  </ItemGroup>

  <Import Project="../KotlinClr.targets" />

  <ItemGroup>
    <KotlinCompile Remove="lib/bin/**;lib/obj/**" />
  </ItemGroup>

</Project>
