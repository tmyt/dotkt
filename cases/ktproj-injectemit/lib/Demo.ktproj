<Project Sdk="Microsoft.NET.Sdk">

  <!-- The nested Kotlin LIBRARY: OutputType=Library makes DotKt emit Demo.dll (no entry point). Its only source
       is Demo.kt (this dir's `**/*.kt` glob). The app both references this emitted dll AND compiles Demo.kt itself. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="../../KotlinClr.targets" />

</Project>
