<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('DotKt.Versions.props', '$(MSBuildThisFileDirectory)'))" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The runtime assembly the DotKt SDK auto-references. Holds lowerings that need cross-assembly identity/ABI
         (printf->composite format, sequence builder, coroutine/Flow helpers) — see dotkt-naming-and-runtime-split. -->
    <AssemblyName>DotKt.Runtime</AssemblyName>
    <RootNamespace>DotKt</RootNamespace>
  </PropertyGroup>
</Project>
