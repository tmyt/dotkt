<?xml version="1.0" encoding="utf-8"?>
<!-- ACTIVE tests-tree NuGet config (from nuget.config.local-sdk.template; design D4 in
     docs/design-nunit-test-harness.md). It routes every DotKt.* package for the NUnit test projects under
     tests/ to the LOCALLY-BUILT SDK feed (build/nuget-feed, produced by `make pack`) instead of a published
     nuget.org version — so the suite tests the compiler in THIS working tree (the whole point: catch current
     bugs). Everything else (NUnit, Microsoft.NET.Test.Sdk, the .NET runtime packs) still comes from nuget.org.

     Isolation (defeats the cache-masking landmine, mirrors tests/packaged-sdk/run.sh): a private
     globalPackagesFolder + cleared fallbackPackageFolders, so a published DotKt.Sdk of the SAME version sitting
     in the user's ~/.nuget/packages can never mask the freshly-packed local one. NuGet prefers an already
     extracted exact-version package, so the gate driver (tests/run-nunit-tests.sh) DELETES the extracted DotKt.*
     dirs from this isolated cache before each restore; NUnit/test-sdk stay cached across runs.
     SDK resolution goes through the NuGet SDK resolver (the projects say <Project Sdk="DotKt.Sdk/<version>">),
     NOT MSBuildSDKsPath — the packaged resolution path we want to exercise. -->
<configuration>
  <config>
    <!-- Isolated per-run cache (repo build/test-package-cache; tests/.gitignore covers it). The gate driver
         clears the DotKt.* subtrees here before restore so a repacked same-version SDK always wins. -->
    <add key="globalPackagesFolder" value="../build/test-package-cache" />
  </config>
  <!-- Do not let an inherited fallback folder (e.g. the SDK's NuGetFallbackFolder or a machine-wide config)
       satisfy DotKt.* from outside the local feed. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="dotkt-local" value="../build/nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="dotkt-local">
      <package pattern="DotKt.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
