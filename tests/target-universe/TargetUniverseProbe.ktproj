<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- #335 deliberately captures ilemit's raw host-scoped output before the existing repair oracle runs. -->
    <DotKtRetarget>false</DotKtRetarget>
  </PropertyGroup>
  <Import Project="../../eng/KotlinClr.targets" />
</Project>
