<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- Capture raw ilemit output; #336 requires it to be target-scoped before the repair oracle runs. -->
    <DotKtRetarget>false</DotKtRetarget>
  </PropertyGroup>
  <Import Project="../../eng/KotlinClr.targets" />
</Project>
