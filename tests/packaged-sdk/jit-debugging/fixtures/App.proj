<Project Sdk="SDK_PLACEHOLDER">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AssemblyName>DebugPolicy</AssemblyName>
  </PropertyGroup>
  <Target Name="RecordResolvedOptions" AfterTargets="Build">
    <WriteLinesToFile File="$(IntermediateOutputPath)resolved-options.txt" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="Optimize=$(Optimize);DebugSymbols=$(DebugSymbols);DebugType=$(DebugType)" />
  </Target>
</Project>
