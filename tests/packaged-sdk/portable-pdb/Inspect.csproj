<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DotKtSharedIrDirectory Condition="'$(DotKtSharedIrDirectory)' == ''">$(MSBuildThisFileDirectory)../../../toolchain/bir-common</DotKtSharedIrDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(DotKtSharedIrDirectory)/TypeNode.cs" Link="TypeNode.cs" />
    <Compile Include="$(DotKtSharedIrDirectory)/BirJson.cs" Link="BirJson.cs" />
  </ItemGroup>
</Project>
