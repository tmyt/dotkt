<Project Sdk="DotKt.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fixture.Consumer" Version="1.0.0" />
    <Reference Include="Native" HintPath="../native/bin/Debug/net10.0/Native.dll" />
    <Reference Include="Library" HintPath="../library/bin/Debug/net10.0/Library.dll" />
    <DotKtCompilerPluginOption Include="dotkt.fixture:answer" Value="second" Condition="'$(RepeatOption)' == 'true'" />
    <!-- Deliberately register the same JAR under a different spelling. -->
    <DotKtCompilerPlugin Include="$([System.IO.Path]::GetFullPath('$(FixturePluginPath)'))" Condition="'$(DuplicatePlugin)' == 'true' and '$(FixturePluginPath)' != ''" />
  </ItemGroup>
</Project>
