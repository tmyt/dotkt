<!-- Round-trip CONSUMER: a DotKt NUnit test project that <ProjectReference>s ../producer and asserts the
     producer's Kotlin API survived the emit -> re-import round-trip. The producer is consumed through its BUILT
     dll (dll2klib re-import of DotKt.Metadata), NEVER its source — the producer sits in a SIBLING directory so
     this project's `**/*.kt` glob cannot capture it (the DLL-not-source invariant, design §3).

     The MSBuild build graph does the "build producer dll -> put it on the consumer's ReferencePath" step, and
     `dotnet test` discovers the @TestAttribute methods and runs them in-process. Assertions use typed values rather
     than a shell-owned stdout protocol (design D1). Resolves the LOCALLY-BUILT SDK from build/nuget-feed via
     tests/nuget.config (design D4); its version is pinned in the repository-root global.json; the gate entry lives
     in tests/run-nunit-tests.sh. -->
<Project Sdk="DotKt.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../producer/RoundtripProducer.ktproj" />
    <ProjectReference Include="../default-property-slot-producer/RoundtripDefaultPropertySlot.ktproj" />
    <ProjectReference Include="../property-slot-producer/RoundtripPropertySlot.csproj" />
    <!-- The MULTIPLATFORM producer (Sdk="DotKt.Sdk.Mpp"): the migrated ktproj-mpp + ktproj-genov-common cases need
         the common/(expect) vs clr/(actual) source-set split, a project-level flag the single-platform
         RoundtripProducer cannot carry — so they live in a SECOND producer, consumed cross-module here alongside
         the first. Its dll is also ilverified via tests/run-nunit-tests.sh EXTRA_EMIT. -->
    <ProjectReference Include="../producer-mpp/RoundtripProducerMpp.ktproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
