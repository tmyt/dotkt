<!-- Round-trip CONSUMER: a DotKt NUnit test project that <ProjectReference>s ../producer and asserts the
     producer's Kotlin API survived the emit -> re-import round-trip. The producer is consumed through its BUILT
     dll (facadegen re-import of DotKt.Metadata), NEVER its source — the producer sits in a SIBLING directory so
     this project's `**/*.kt` glob cannot capture it (the DLL-not-source invariant, design §3).

     This single NUnit project replaces the hand-rolled compile-then-consume orchestration of
     scripts/verify-roundtrip.sh: the MSBuild build graph already does the "build producer dll -> put it on the
     consumer's ReferencePath" step, and `dotnet test` discovers the @TestAttribute methods and runs them
     in-process. Each method migrates ONE verify-roundtrip.sh section, preserving its golden values 1:1 as
     ClassicAssert value asserts (design D1). Resolves the LOCALLY-BUILT SDK from build/nuget-feed via
     tests/nuget.config (design D4); version tracks packaging/DotKt.Versions.props; the count-guard entry lives
     in tests/run-nunit-il.sh (EXPECTED["tests/roundtrip/consumer"]). -->
<Project Sdk="DotKt.Sdk/0.9.6-rc7">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../producer/RoundtripProducer.ktproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
