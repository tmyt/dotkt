<!-- Basic Kotlin language and standard-library NUnit suite.
     (docs/design-nunit-test-harness.md; playbook docs/nunit-migration-playbook.md). Every .kt under this
     project is Kotlin, compiled to CLR IL by the DotKt MSBuild SDK; `dotnet test` discovers the @TestAttribute
     methods and runs them in-process/parallel. Each fixture is a coherent feature family: many former
     stdout-diff cases -> @TestAttribute methods asserting the VALUE directly, compiled ONCE per assembly.

     This suite resolves the LOCALLY-BUILT SDK from build/nuget-feed via tests/nuget.config (design D4) — so it
     tests the compiler in THIS working tree. The pinned version tracks packaging/DotKt.Versions.props (DotKtVersionPrefix +
     -DotKtVersionSuffix); the gate driver tests/run-nunit-tests.sh reads it from there and clears the isolated
     cache so a repacked same-version SDK always wins. -->
<Project Sdk="DotKt.Sdk/0.9.6-rc7">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
