<!-- NUnit in-process pilot for the cases/il-* migration (docs/design-nunit-test-harness.md).
     Every .kt under this project is Kotlin, compiled to CLR IL by the DotKt MSBuild SDK; `dotnet test`
     discovers the @TestAttribute methods and runs them in-process/parallel.

     SDK version: the PILOT pins the PUBLISHED 0.9.6-rc7 (present in the local NuGet cache) to prove the
     concept offline. The LOCAL-repo path (design §"Local SDK") swaps this for the make-pack output via
     nuget.config -> build/nuget-feed + a locally-built version; see the design doc. -->
<Project Sdk="DotKt.Sdk/0.9.6-rc7">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Deterministic order for the pilot timing measurement; NUnit does not parallelize within an
         assembly unless a fixture opts in via [Parallelizable]. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
