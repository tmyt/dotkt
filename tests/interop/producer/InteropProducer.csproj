<!-- C#-producer roundtrip PRODUCER: a plain C# class library consumed by ../consumer through a
     <ProjectReference>. MSBuild builds this csproj
     first, its implementation dll lands on the consumer's @(ReferencePath)+@(ReferenceCopyLocalPaths), and the
     DotKt pipeline projects its declarations to a reference KLIB while bir2cir and ilemit use the resolved CLR
     references.

     Each .cs here has its OWN namespace so the many colliding simple names
     (Item/Bag/Sink from clrasm/clriface/geninj) coexist in this single producer assembly — the same per-package
     split the DotKt roundtrip producer uses. This is a plain csc-emitted assembly (no DotKt.Metadata);
     the round-trip is "consume a separately-compiled .NET dll AS façade-free Kotlin", the very cross-module shape
     these cases exist to prove. Nullable DISABLED (oblivious): required by Extlib.cs (ktproj-extlib) — its reference-
     type property must surface as the Kotlin PLATFORM type String! (ConeFlexibleType), which only an oblivious/
     non-NRT assembly produces; the other cases carry no NRT-dependent surface. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
