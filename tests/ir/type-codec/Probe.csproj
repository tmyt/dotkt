<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DotKtBir2CirPath Condition="'$(DotKtBir2CirPath)' == ''">$(MSBuildThisFileDirectory)../../../build/bir2cir-bin/bir2cir.dll</DotKtBir2CirPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the production codec, not another compiled or reimplemented test copy. -->
    <Reference Include="bir2cir">
      <HintPath>$(DotKtBir2CirPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
