# `t.await(captureContext = capture)` — a NON-CONSTANT Boolean (GitHub #64). This whole document was a compile
# ABORT before the fix (`EmitAwaitPoint` threw on anything but a constant), so its acceptance is half the
# assertion; the other half is that the value is simply handed to `ConfigureAwait` — the parameter is read once,
# in the argument slot — and that the state-machine field is the CONFIGURED awaiter, statically, with no branch
# between two awaiter types anywhere. Runtime behavior is asserted by
# tests/coroutines/fixtures/DynamicCaptureContextTests.kt; what only the shape can show is that the Boolean
# selected no type.
+"method":"ConfigureAwait"
+"name":"capture","ret":{"t":"fqn","name":"System.Boolean"}
+"method":"GetAwaiter"
# The awaiter FIELD type, as the emitted document escapes it (\u0060 is the arity backtick, \u002B the nested-type
# separator): the nested ConfiguredTaskAwaiter, not the awaitable's own TaskAwaiter.
+"name":"__awaiter$1","type":{"t":"fqn","name":"System.Runtime.CompilerServices.ConfiguredTaskAwaitable\u00601\u002BConfiguredTaskAwaiter"
